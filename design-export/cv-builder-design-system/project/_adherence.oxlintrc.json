{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/effects/**",
              "components/resume/**",
              "ui_kits/cv-builder/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Calibri|Cambria|Geist Mono|Inter|Lato|Roboto|IBM Plex Sans|EB Garamond|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Calibri, Cambria, Geist Mono, Inter, Lato, Roboto, IBM Plex Sans, EB Garamond, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, image, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|matched|missing|info|warn|solid)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'matched' | 'missing' | 'info' | 'warn' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassicResume'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|meta|key|ref|className|style|children)$/]",
        "message": "<ClassicResume> doesn't accept that prop. Declared props: data, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExecutiveResume'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|meta|key|ref|className|style|children)$/]",
        "message": "<ExecutiveResume> doesn't accept that prop. Declared props: data, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|elevation|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: as, elevation, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<GlassCard> elevation must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|type|disabled|mono|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, type, disabled, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|showWordmark|wordmark|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, showWordmark, wordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='MinimalResume'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|meta|key|ref|className|style|children)$/]",
        "message": "<MinimalResume> doesn't accept that prop. Declared props: data, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModernResume'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|meta|key|ref|className|style|children)$/]",
        "message": "<ModernResume> doesn't accept that prop. Declared props: data, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlasmaBackground'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|speed|scale|opacity|direction|mouseInteractive|overlay|children|style|key|ref|className|style|children)$/]",
        "message": "<PlasmaBackground> doesn't accept that prop. Declared props: color, speed, scale, opacity, direction, mouseInteractive, overlay, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlasmaBackground'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:forward|reverse|pingpong)$/]",
        "message": "<PlasmaBackground> direction must be one of 'forward' | 'reverse' | 'pingpong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|onChange|minLabel|maxLabel|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, onChange, minLabel, maxLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|label|showValue|key|ref|className|style|children)$/]",
        "message": "<ScoreBar> doesn't accept that prop. Declared props: value, max, label, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarResume'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|meta|key|ref|className|style|children)$/]",
        "message": "<SidebarResume> doesn't accept that prop. Declared props: data, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
